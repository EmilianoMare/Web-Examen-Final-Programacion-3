@{
}

<!-- Encabezado principal y botones de acción -->
<div class="row mt-4">
    <div class="col-sm-8 offset-sm-2">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="mb-0" id="title">Nuevo gasto</h2>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-success" id="btnSaveSale">Guardar</button>
                <a class="btn btn-warning" href="/Sale/Index">Volver</a>
            </div>
        </div>

        <!-- Formulario principal de la venta -->
        <form id="saleForm">
            <!-- Datos del cliente -->
            <div class="input-group mb-3">
                <span class="input-group-text">Comercio o beneficiario</span>
                <input type="text" class="form-control" id="customerName" name="customerName">
            </div>

            <hr />

            <!-- Entrada para detalle de un nuevo producto -->
            <div class="input-group mb-3">
                <span class="input-group-text">Concepto del gasto</span>
                <input type="text" class="form-control" id="productName">
            </div>

            <div class="d-flex gap-2">
                <div class="input-group mb-3">
                    <span class="input-group-text">Precio</span>
                    <input type="number" class="form-control" id="price">
                </div>
                <div class="input-group mb-3">
                    <span class="input-group-text">Cantidad</span>
                    <input type="number" class="form-control" id="quantity">
                </div>
            </div>

            <!-- Botón para incorporar el producto a la lista -->
            <div class="d-grid mb-3">
                <button type="button" class="btn btn-primary" id="btnAddProduct">Agregar Gasto</button>
            </div>

            <!-- Tabla dinámicamente poblada con los productos agregados -->
            <table class="table" id="tbProducts">
                <thead>
                    <tr>
                        <th>Concepto</th>
                        <th>Precio</th>
                        <th>Cantidad</th>
                        <th>Subtotal</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </form>
    </div>
</div>


@section Scripts {

    <script>
        //#region 1. Variables Globales e Inicialización
        const myLoader = new AvalynxLoader("#saleForm");
        let products = [];
        let saleId = 0;
        //#endregion

        //#region 2. Carga Inicial y Obtención de Datos (Edición)
        window.addEventListener("load", () => {
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.has("saleId")) {
                document.getElementById("title").textContent = "Editar gasto";
                saleId = urlParams.get("saleId");
                showSale();
            }
        });

        async function showSale() {
            myLoader.load = true;
            try {
                const response = await fetch(`/Sale/Get?SaleId=${encodeURIComponent(saleId)}`);
                const result = await response.json();
                if (!response.ok) {
                    throw new Error(result.message || "No se pudo cargar la venta.");
                }
                document.getElementById("customerName").value = result.customerName ?? "";
                products = (result.saleDetails ?? []).map(p => ({
                    productName: p.productName,
                    price: p.price,
                    quantity: p.quantity,
                    subtotal: p.price * p.quantity
                }));
                updateProductTable();
            } catch (error) {
                Swal.fire({ text: error.message, icon: "error" });
            }
            finally {
                myLoader.load = false;
            }
        }
        //#endregion

        //#region 3. Gestión de Productos (Agregar, Renderizar, Eliminar)
        document.getElementById("btnAddProduct").addEventListener("click", () => {
            const productName = document.getElementById("productName").value;
            const price = parseFloat(document.getElementById("price").value);
            const quantity = parseInt(document.getElementById("quantity").value);

            if (!productName || !Number.isFinite(price) || price <= 0 || !Number.isInteger(quantity) || quantity <= 0) {
                Swal.fire({
                    text: "Complete todos los campos del gasto",
                    icon: "error", timer: 1600, position: "top"
                });
                return;
            }

            const subtotal = price * quantity;

            const product = {
                productName: productName,
                price: price,
                quantity: quantity,
                subtotal: subtotal
            };

            products.push(product);

            updateProductTable();

            document.getElementById("productName").value = "";
            document.getElementById("price").value = "";
            document.getElementById("quantity").value = "";
        });

        function updateProductTable() {
            const tbody = document.querySelector("#tbProducts tbody");
            tbody.innerHTML = "";

            products.forEach((product, index) => {
                const row = tbody.insertRow();

                row.insertCell(0).textContent = product.productName;
                row.insertCell(1).textContent = product.price.toFixed(2);
                row.insertCell(2).textContent = product.quantity;
                row.insertCell(3).textContent = product.subtotal.toFixed(2);

                const deleteCell = row.insertCell(4);
                const deleteBtn = document.createElement("button");
                deleteBtn.textContent = "Eliminar";
                deleteBtn.className = "btn btn-danger btn-sm";
                deleteBtn.onclick = () => removeProduct(index);
                deleteCell.appendChild(deleteBtn);
            });
        }

        function removeProduct(index) {
            products.splice(index, 1);
            updateProductTable();
        }
        //#endregion

        //#region 4. Guardado / Envío del Formulario
        document.getElementById("btnSaveSale").addEventListener("click", async () => {
            const customerName = document.getElementById("customerName").value;
            if (!customerName) {
                Swal.fire({
                    text: "Ingrese el comercio o beneficiario",
                    icon: "error", timer: 1600, position: "top"
                });
                return;
            }

            if (products.length === 0) {
                Swal.fire({
                    text: "Agregue al menos un concepto de gasto",
                    icon: "error", timer: 1600, position: "top"
                });
                return;
            }

            myLoader.load = true;

            const saleData = {
                saleId: saleId == 0 ? 0 : saleId,
                customerName: customerName,
                totalAmount: products.reduce((sum, product) => sum + product.subtotal, 0),
                saleDetails: products.map(p => ({
                    productName: p.productName,
                    price: p.price,
                    quantity: p.quantity,
                }))
            };

            const urlAction = saleId == 0 ? '/Sale/Create' : '/Sale/Edit';
            const methodAction = saleId == 0 ? 'POST' : 'PUT';

            try {
                const response = await fetch(urlAction, {
                    method: methodAction,
                    headers: { 'Content-type': 'application/json' },
                    body: JSON.stringify(saleData)
                });
                const result = await response.json();
                if (!response.ok) {
                    throw new Error(result.message || "No se pudo guardar la venta.");
                }
                await Swal.fire({ text: result.message, icon: "success", timer: 1500, position: "top" });
                if (saleId != 0) {
                    window.location.href = "/Sale/Index";
                } else {
                    document.getElementById("customerName").value = "";
                    products = [];
                    updateProductTable();
                }
            } catch (error) {
                Swal.fire({ text: error.message, icon: "error", timer: 1500, position: "top" });
            } finally {
                myLoader.load = false;
            }
        });
        //#endregion
    </script>
}
